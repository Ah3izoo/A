rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity probe only: readable, never writable.
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Sales records: signed-in users only.
    // TODO: tighten to your own account, e.g.
    //   request.auth.token.email == 'you@example.com'
    match /salesRecords/{recordId} {
      allow read, write: if request.auth != null;
    }

    // Product catalog / price list: signed-in users only.
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
